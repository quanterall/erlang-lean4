{application, lean_check,
 [{description, "Lean 4 proof checking for Erlang: a supervised pool of Lean REPL workers with Mathlib"},
  {vsn, "0.1.0"},
  {registered, [lean_check_sup, lean_check_pool]},
  {mod, {lean_check_app, []}},
  {applications, [kernel, stdlib]},
  {env, [{workers, 1},                                 % REPL processes, each holding Mathlib in memory (~several GB)
         {env_dir, "/env"},                            % the Lake project whose packages a check may import
         {repl, "/repl/.lake/build/bin/repl"},
         {header, "import Mathlib"},                   % the base environment every check starts from
         {start_timeout, 900000},                      % importing Mathlib: up to 15 minutes on a cold cache
         {max_checks, 100}                             % a worker restarts after this many checks (the REPL keeps every environment)
        ]},
  {licenses, ["Apache-2.0"]},
  {links, []}]}.
